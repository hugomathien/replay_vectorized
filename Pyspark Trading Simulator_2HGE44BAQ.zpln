    {
      "title": "Backtester",
      "text": "%sql\n\nselect date,\nsum(dayPnl) over(order by date) as cumPnl,\nnetDelta,\ngrossDelta,\ngrossTurnover\n\nfrom (\n    select date,\n    count(*) as cnt,\n    sum(backtest.dayPnl*fx) as dayPnl,\n    sum((backtest.positionNetQuantity)*backtest.valuationPrice*fx) as netDelta,\n    sum(abs(backtest.positionNetQuantity)*backtest.valuationPrice*fx) as grossDelta,\n    sum(abs(backtest.tradeNetQuantity)*backtest.valuationPrice*fx) as grossTurnover\n    from (\n        select date,ticker,isTradingDay,inUniverse,fx,budget,weight,direction,tradingSim(isTradingDay,${priceColumn},direction,weight,budget,${alphaBudget},${holdingPeriod},${maxTradeSize},${maxPositionSize},${maxTradeAdv},${maxPositionAdv},${fx},volume,adv_20d,dayCount,${rebalFrequency},ticker) over(partition by ticker order by date) as backtest from (select *,${budget} as budget,${weight} as weight,count(*) over(partition by date,inUniverse,isActive,direction) as evtCount from df_backtest where 1\u003d1 and ${filter}) order by date\n    )\ngroup by date\n)",
      "user": "anonymous",
      "dateUpdated": "2024-04-10 15:38:35.823",
      "progress": 19,
