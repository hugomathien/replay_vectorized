{
  "paragraphs": [
    {
      "title": "Market Making Simulator",
      "text": "%spark\nimport org.apache.spark.sql.expressions.MutableAggregationBuffer\nimport org.apache.spark.sql.expressions.UserDefinedAggregateFunction\nimport org.apache.spark.sql.Row\nimport org.apache.spark.sql.types._\nimport scala.collection.mutable._\nimport scala.math.pow\nimport scala.math.log\nimport scala.math.sqrt\n\nclass MMTradingSimulator extends UserDefinedAggregateFunction {\n  var count \u003d 0L\n  \n  // This is the input fields for the aggregate function.\n  override def inputSchema \u003d new StructType()\n                                .add(\"isTrading\", BooleanType)\n                                .add(\"open\", DoubleType,true)\n                                .add(\"last\", DoubleType,true)\n                                .add(\"high\", DoubleType,true)\n                                .add(\"low\", DoubleType,true)\n                                .add(\"A_bid\", DoubleType,true)\n                                .add(\"k_bid\", DoubleType,true)\n                                .add(\"A_ask\", DoubleType,true)\n                                .add(\"k_ask\", DoubleType,true)\n                                .add(\"sigma\", DoubleType,true)\n                                .add(\"mu\", DoubleType,true)\n                                .add(\"lamda\", DoubleType,true)\n                                .add(\"max_inventory\", DoubleType,true)\n                                .add(\"min_inventory\", DoubleType,true)\n                                .add(\"budget_bid\", DoubleType,true)\n                                .add(\"budget_ask\", DoubleType,true)\n                                .add(\"maker_fee_bps\", DoubleType,true)\n                                .add(\"taker_fee_bps\", DoubleType,true)\n                                .add(\"initial_cash\", DoubleType,true)\n                                \n  // This is the internal fields we keep for computing the aggregate.\n  override def bufferSchema: StructType \u003d StructType(\n    StructField(\"cash\", DoubleType) ::\n    StructField(\"mtm\", DoubleType) ::\n    StructField(\"pnl\", DoubleType) ::\n    StructField(\"fee\", DoubleType) ::\n    StructField(\"netpnl\", DoubleType) ::\n    StructField(\"inventory\", DoubleType) ::\n    StructField(\"bidQty\", DoubleType) ::\n    StructField(\"askQty\", DoubleType) ::\n    StructField(\"bid_spread\", DoubleType) ::\n    StructField(\"ask_spread\", DoubleType) ::\n    StructField(\"turnover\", DoubleType) ::\n    StructField(\"buy\", IntegerType) ::\n    StructField(\"sell\", IntegerType) ::\n    StructField(\"toRebalance\", BooleanType) :: Nil\n  )\n\n  // This is the output type of the aggregatation function.\n  override def dataType: StructType \u003d StructType(\n    StructField(\"cash\", DoubleType) ::\n    StructField(\"mtm\", DoubleType) ::\n    StructField(\"pnl\", DoubleType) ::\n    StructField(\"fee\", DoubleType) ::\n    StructField(\"netpnl\", DoubleType) ::\n    StructField(\"inventory\", DoubleType) ::\n    StructField(\"bidQty\", DoubleType) ::\n    StructField(\"askQty\", DoubleType) ::\n    StructField(\"bid_spread\", DoubleType) ::\n    StructField(\"ask_spread\", DoubleType) ::\n    StructField(\"turnover\", DoubleType) ::\n    StructField(\"buy\", IntegerType) ::\n    StructField(\"sell\", IntegerType) ::\n    StructField(\"toRebalance\", BooleanType) :: Nil\n  )\n\n  override def deterministic: Boolean \u003d true\n\n  // This is the initial value for our buffer schema.\n  override def initialize(buffer: MutableAggregationBuffer): Unit \u003d {\n    buffer(0) \u003d 0D\n    buffer(1) \u003d 0D\n    buffer(2) \u003d 0D\n    buffer(3) \u003d 0D\n    buffer(4) \u003d 0D\n    buffer(5) \u003d 0D\n    buffer(6) \u003d 0D\n    buffer(7) \u003d 0D\n    buffer(8) \u003d 0D\n    buffer(9) \u003d 0D\n    buffer(10) \u003d 0D\n    buffer(11) \u003d 0\n    buffer(12) \u003d 0    \n    buffer(13) \u003d true\n  }\n\n  override def update(buffer: MutableAggregationBuffer, input: Row): Unit \u003d {\n    // Extract row values from the input\n    val isTrading \u003d input.getAs[Boolean](0)\n    val open \u003d input.getAs[Double](1)\n    val last \u003d input.getAs[Double](2)\n    val high \u003d input.getAs[Double](3)\n    val low \u003d input.getAs[Double](4)\n    val A_bid \u003d input.getAs[Double](5)\n    val k_bid \u003d input.getAs[Double](6)\n    val A_ask \u003d input.getAs[Double](7)\n    val k_ask \u003d input.getAs[Double](8)\n    val sigma \u003d input.getAs[Double](9)\n    val mu \u003d input.getAs[Double](10)\n    val lda \u003d input.getAs[Double](11)\n    val max_inventory \u003d input.getAs[Double](12)\n    val min_inventory \u003d input.getAs[Double](13)\n    val budget_bid \u003d input.getAs[Double](14)\n    val budget_ask \u003d input.getAs[Double](15)\n    val maker_fee_bps \u003d input.getAs[Double](16)\n    val taker_fee_bps \u003d input.getAs[Double](17)\n    val initial_cash \u003d input.getAs[Double](18)\n    \n    if (count \u003d\u003d 0) {\n        buffer(0) \u003d initial_cash / 2f // set the starting coin inventory to mirror the dollar cash position\n        buffer(5) \u003d initial_cash  / (open*2f) // set the starting coin inventory to mirror the dollar cash position\n        buffer(1) \u003d buffer.getDouble(5) * open\n    }\n    \n    var toRebalance \u003d buffer.getBoolean(13)\n    var usdcash \u003d buffer.getDouble(0) // USD Cash\n    \n    if(isTrading \u0026 toRebalance) {\n        var startInventory \u003d buffer.getDouble(5)\n        var startInventoryUSD \u003d startInventory * open\n        \n        // Calculate bid and ask\n        var bid_spread \u003d (1f / lda) * log(1f+lda/k_bid) + ((-mu/(lda*sigma*sigma))+(2f*startInventoryUSD+1f)/2f)*sqrt(pow((1f+lda/k_bid),(1f+k_bid/lda))*(sigma*sigma*lda)/(2f*k_bid*A_bid))\n        bid_spread \u003d bid_spread.max(0f)\n        var ask_spread \u003d (1f / lda) * log(1f+lda/k_ask) + ((mu/(lda*sigma*sigma))-(2f*startInventoryUSD-1f)/2f)*sqrt(pow((1f+lda/k_ask),(1f+k_ask/lda))*(sigma*sigma*lda)/(2f*k_ask*A_ask))\n        ask_spread \u003d ask_spread.max(0f)\n        \n        var bid \u003d open - bid_spread\n        var ask \u003d open + ask_spread\n        \n        // Calculate the quantity we posted at bid/offer\n        var bidQty \u003d budget_bid.min(usdcash) / bid\n        var askQty \u003d (budget_ask/ask).min(startInventory)\n        var bidQtyUSD \u003d bidQty * bid\n        var askQtyUSD \u003d askQty * ask\n        \n        // Check if we bought and/or sold\n        var sell \u003d 0\n        if(ask \u003c\u003d high) {\n            sell \u003d 1\n        }\n        var buy \u003d 0\n        if (bid\u003e\u003dlow) {\n            buy \u003d 1\n        }\n        \n        // Calculate what will be our position after the unwind and risk trade\n        var inventory \u003d startInventory + bidQty * buy - askQty * sell\n        var turnover \u003d bidQty * buy * bid + askQty * sell * ask\n        \n        // Calculate today\u0027s pnl\n        val fee \u003d (bidQtyUSD * buy + askQtyUSD * sell) * maker_fee_bps / 1e4\n        val cash \u003d usdcash - bidQtyUSD * buy + askQtyUSD * sell // cash position in usd at the end of the period\n        val mtm \u003d inventory * last  // mark to market in local ccy at the end of the period\n        val pnl \u003d cash+mtm - buffer.getDouble(0) - buffer.getDouble(1) // in local ccy\n        val netpnl \u003d pnl - fee\n        \n        // Update the buffer\n        buffer(0) \u003d cash\n        buffer(1) \u003d mtm\n        buffer(2) \u003d pnl\n        buffer(3) \u003d fee\n        buffer(4) \u003d netpnl\n        buffer(5) \u003d inventory\n        buffer(6) \u003d bidQty\n        buffer(7) \u003d askQty\n        buffer(8) \u003d -1*bid_spread\n        buffer(9) \u003d ask_spread\n        buffer(10) \u003d turnover\n        buffer(11) \u003d buy\n        buffer(12) \u003d sell\n        buffer(13) \u003d true // Set to false if we stop trading\n        count +\u003d 1\n    }\n    \n  }\n\n  // This is how to merge two objects with the bufferSchema type.\n  override def merge(buffer1: MutableAggregationBuffer, buffer2: Row): Unit \u003d {\n    \n  }\n\n  // The output is our buffer, we can extract the values using StructType, for example \"backtest.day_pnl\"\n  override def evaluate(buffer: Row)\u003d buffer\n}\n\n// Register to use with Spark SQL and access via Pyspark\nspark.udf.register(\"mmTradingSim\", new MMTradingSimulator)\n",
      "user": "anonymous",
      "dateUpdated": "2024-03-23 12:12:01.037",
      "progress": 0,
