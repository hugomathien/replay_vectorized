    {
      "title": "Alpha curve",
      "text": "%pyspark\n\nalpha \u003d z.textbox(\"Alpha\")\nsignal \u003d z.textbox(\"Signal\")\ndenPrice \u003d z.textbox(\"Entry price column\")\nnumPrice \u003d z.textbox(\"Exit price column\")\nlookahead \u003d int(z.textbox(\"Profile Lookahead\"))+1\nlookback \u003d int(z.textbox(\"Profile Lookback\"))+1\nfilter \u003d z.textbox(\"Filter\")\n\nprofile_window_size \u003d lookback+lookahead\nunpivot_expr \u003d \u0027,\u0027.join([f\"\u0027{n}\u0027,lead_return_{n}\" for n in range(1,lookahead)] + [f\"\u0027-{n}\u0027,lag_return_{n}\" for n in range(1,lookback)])\nunpivot_expr \u003d f\"stack({profile_window_size}-2,{unpivot_expr}) as (price_return_horizon,price_return)\"\nreturn_cols \u003d [f\u0027avg(lead_return_{n})\u0027 for n in range(1,lookahead)] + [f\u0027avg(lag_return_{n})\u0027 for n in range(1,lookback)]\n\ndf_alpha_curve \u003d df.transform(build_profile_pivoted(alpha,signal,numPrice,denPrice,lookback,lookahead))\ndf_alpha_curve_group \u003d df_alpha_curve.groupBy(\"signal\",\"inUniverse\").agg(*[avg(expr(f\"10000*lag_return_{x}\")).alias(f\u0027lag_return_{x}\u0027) for x in range(1,lookback)]+[avg(expr(f\"10000*lead_return_{x}\")).alias(f\u0027lead_return_{x}\u0027) for x in range(1,lookahead)])\n\ndf_alpha_curve_group.registerTempTable(\"df_alpha_curve\")\n\ndf_alpha_curve_group \u003d df_alpha_curve_group.select(\u0027signal\u0027,\u0027inUniverse\u0027,expr(unpivot_expr))\n\ndf_alpha_curve_group.registerTempTable(\"df_alpha_curve_group\")\n\nz.show(spark.sql(f\"select * from df_alpha_curve_group where 1\u003d1 and {filter}\"))",
