  "paragraphs": [
    {
      "title": "Hedged Index",
      "text": "%spark\nimport org.apache.spark.sql.expressions.MutableAggregationBuffer\nimport org.apache.spark.sql.expressions.UserDefinedAggregateFunction\nimport org.apache.spark.sql.Row\nimport org.apache.spark.sql.types._\n\nclass HedgedIndex extends UserDefinedAggregateFunction {\n  // This is the input fields for your aggregate function.\n  override def inputSchema \u003d new StructType()\n                                .add(\"isTradingDay\", BooleanType)\n                                .add(\"stockPrice\", DoubleType,true)\n                                .add(\"hedgePrice\", DoubleType,true)\n \n  \n  // This is the internal fields you keep for computing your aggregate.\n  override def bufferSchema: StructType \u003d StructType(\n    StructField(\"index\", DoubleType) ::\n    StructField(\"stockPrice\", DoubleType) ::\n    StructField(\"hedgePrice\", DoubleType) :: Nil\n  )\n\n  // This is the output type of your aggregatation function.\n  override def dataType: DataType \u003d DoubleType\n\n  override def deterministic: Boolean \u003d true\n\n  // This is the initial value for your buffer schema.\n  override def initialize(buffer: MutableAggregationBuffer): Unit \u003d {\n    buffer(0) \u003d 1D\n    buffer(1) \u003d 0D\n    buffer(2) \u003d 0D\n  }\n\n  // This is how to update your buffer schema given an input.\n  override def update(buffer: MutableAggregationBuffer, input: Row): Unit \u003d {\n      \n    var isTradingDay \u003d input.getBoolean(0)\n    \n    if(isTradingDay \u0026\u0026 (input.isNullAt(1) \u003d\u003d false \u0026\u0026 input.isNullAt(2) \u003d\u003d false)) {\n        val stock_price \u003d input.getDouble(1)\n        val hedge_price\u003d input.getDouble(2)\n        \n        val previous_stock_price \u003d if (buffer.getAs[Double](1) \u003e 0D) buffer.getAs[Double](1) else stock_price\n        val previous_hedge_price \u003d if (buffer.getAs[Double](2) \u003e 0D) buffer.getAs[Double](2) else hedge_price\n        val newIdx \u003d buffer.getAs[Double](0) * (1 + (stock_price / previous_stock_price) - (hedge_price / previous_hedge_price))\n        if(newIdx\u003e0) {\n            buffer(0) \u003d buffer.getAs[Double](0) * (1 + (stock_price / previous_stock_price) - (hedge_price / previous_hedge_price))\n            buffer(1) \u003d stock_price\n            buffer(2) \u003d hedge_price\n        }\n    }\n      \n  }\n\n  // This is how to merge two objects with the bufferSchema type.\n  override def merge(buffer1: MutableAggregationBuffer, buffer2: Row): Unit \u003d {\n    //buffer1(0) \u003d buffer1.getAs[Boolean](0)\n    //buffer1(1) \u003d buffer1.getAs[Double](1) * buffer2.getAs[Double](1)\n  }\n\n  // This is where you output the final value, given the final value of your bufferSchema.\n  override def evaluate(buffer: Row): Any \u003d {\n    buffer.getDouble(0)\n  }\n}\n\nspark.udf.register(\"hedgedIndex\", new HedgedIndex)\n",
      "user": "anonymous",
      "dateUpdated": "2024-04-15 13:43:03.318",
