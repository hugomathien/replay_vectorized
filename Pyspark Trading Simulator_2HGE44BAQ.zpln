    {
      "text": "%sql\nselect date,\nsum(dayPnl) over(order by date) as cumPnl,\ndelta,\nabs(delta) as grossDelta,\ncnt\nfrom (\n    select date,\n    count(*) as cnt,\n    sum(delta*priceReturn) as dayPnl,\n    sum(abs(delta)) as delta\n    from (\n        select date,\n               ticker,\n               isTradingDay,\n               inUniverse,\n               fx,\n               budget,\n               weight,\n               direction,\n               (last(direction*budget*weight,True) over(partition by ticker order by date rows between 10 preceding and 1 preceding)) as delta,\n               (last(px_last,True) over(partition by ticker order by date rows between 10 preceding and current row)/last(px_last,True) over(partition by ticker order by date rows between 10 preceding and 1 preceding)-1) as priceReturn \n               from (select *,${budget} as budget,${weight} as weight from df_backtest where 1\u003d1 and ${filter}) order by date\n    )\n    where inUniverse\u003d1\n    group by date\n)",
      "user": "anonymous",
      "dateUpdated": "2023-08-30 16:06:09.821",
