            "data": "root\n |-- date: date (nullable \u003d true)\n |-- market_hdg_ticker: string (nullable \u003d true)\n |-- ticker: string (nullable \u003d true)\n |-- crncy: string (nullable \u003d true)\n |-- datetime: timestamp (nullable \u003d true)\n |-- month: integer (nullable \u003d true)\n |-- instrumentType: string (nullable \u003d true)\n |-- universe: string (nullable \u003d true)\n |-- px_last: double (nullable \u003d true)\n |-- open: double (nullable \u003d true)\n |-- high: double (nullable \u003d true)\n |-- low: double (nullable \u003d true)\n |-- vwap: double (nullable \u003d true)\n |-- volume: long (nullable \u003d true)\n |-- official_open_auction_volume: double (nullable \u003d true)\n |-- official_close_auction_volume: double (nullable \u003d true)\n |-- eqy_sh_out: double (nullable \u003d true)\n |-- eqy_free_float_pct: double (nullable \u003d true)\n |-- year: integer (nullable \u003d true)\n |-- dayCount: integer (nullable \u003d true)\n |-- isTradingDay: boolean (nullable \u003d false)\n |-- isActive: boolean (nullable \u003d true)\n |-- adv_20d: double (nullable \u003d true)\n |-- inUniverse: integer (nullable \u003d true)\n |-- exch_code: string (nullable \u003d true)\n |-- industry_sector: string (nullable \u003d true)\n |-- industry_group: string (nullable \u003d true)\n |-- fx: double (nullable \u003d false)\n |-- return_1d: double (nullable \u003d true)\n |-- vol_10d: double (nullable \u003d true)\n |-- vol_20d: double (nullable \u003d true)\n |-- isEarningsDay_Q: integer (nullable \u003d true)\n |-- cf_free_cash_flow: double (nullable \u003d true)\n |-- cf_free_cash_flow_growth_4: double (nullable \u003d true)\n |-- cf_free_cash_flow_growth_4_cs_iqr_industry_sector: double (nullable \u003d true)\n |-- market_hdg_px_last: double (nullable \u003d true)\n |-- market_hedged_px_last: double (nullable \u003d true)\n\n13051804"
