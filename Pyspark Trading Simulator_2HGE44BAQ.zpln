    {
      "title": "Prepare data",
      "text": "%pyspark\nfrom pyspark import StorageLevel\n\nspark.catalog.clearCache()\n\ndf \u003d load_technical() \\\n    .transform(join_composition) \\\n    .transform(join_static_data()) \\\n    .transform(join_fx) \\\n    .transform(lag_return()) \\\n    .transform(volume_stats(advLookbacks\u003d[10,20])) \\\n    .transform(volatility_stats(volLookbacks\u003d[10,20],annualize\u003dFalse)) \\\n    .transform(join_fundamental([\"cash_flow_statement\"],[\"Q\"],cols\u003d[\"cf_free_cash_flow\"])) \\\n    .transform(forward_fill([\"cf_free_cash_flow_growth_4\"])) \\\n    .transform(cs_iqr(\"industry_sector\",[\"cf_free_cash_flow_growth_4\"])) \\\n    .transform(join_hedges(\"index\",\"geo\",\"exch_code\",\"market\",mkt_hedge_index_map)) \\\n    .transform(stats_hedges(\"market\",\"px_last\")) \\\n    .cache()\n\ndf.printSchema()\ndf.registerTempTable(\"master_df\")\ndf.count()\n\n# .transform(join_fundamental([\"cash_flow_statement\"],[\"Q\"],cols\u003d[\"cf_free_cash_flow\"])) \\\n#    .transform(forward_fill([\"cf_free_cash_flow_growth_4\"])) \\\n#    .transform(cs_z_score(\"industry_sector\",[\"cf_free_cash_flow_growth_4\"])) \\",
