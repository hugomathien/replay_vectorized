{
  "paragraphs": [
    {
      "title": "Functions",
      "text": "%pyspark\nfrom pyspark.sql.window import Window\nfrom pyspark.sql.functions import *\nfrom pyspark.sql.functions import pandas_udf\nfrom pyspark.sql.types import DoubleType\nfrom itertools import chain\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import zscore\n\nasset_type\u003d\"equity\"\ndata_source_path \u003d \"/opt/data/parquet/\"\nregion \u003d \"amrs\"\nindex \u003d \"ray\"\ninstrumentWindowRolling \u003d Window.partitionBy(\"ticker\").orderBy(\"date\")\ninstrumentWindow \u003d lambda a,b : Window.partitionBy(\"ticker\").orderBy(\"date\").rowsBetween(a,b)\nstandardColumns \u003d [\"date\",\"datetime\",\"year\",\"month\",\"ticker\",\"instrumentType\",\"universe\"]\nperiodicities_lag \u003d {\"Q\" : 4, \"S\" : 2}\ngeo_hedge_index_map \u003d {\n    \u0027LN\u0027: \u0027TUKXG\u0027,\n    \u0027FP\u0027: \u0027CACR\u0027,\n    \u0027GY\u0027: \u0027DAX\u0027\n}\n\nmkt_hedge_index_map \u003d {\n    \u0027LN\u0027: \u0027SXXR\u0027,\n    \u0027FP\u0027: \u0027SXXR\u0027,\n    \u0027GY\u0027: \u0027SXXR\u0027,\n    \u0027US\u0027: \u0027SPTR\u0027,\n}\n\n@pandas_udf(\u0027float\u0027)\ndef zscore_udf(x: pd.Series) -\u003e pd.Series:\n    return zscore(x)\n    \nspark.udf.register(\"z_score\", zscore_udf)\n\n\ndef load_technical():\n    return spark.read.format(\"parquet\") \\\n        .load(f\"{data_source_path}/{asset_type}/{region}/{index}/technical\") \\\n        .withColumn(\"dayCount\",expr(\"dense_rank() over(order by date)\")) \\\n        .withColumn(\"isTradingDay\",when(expr(\"!isNull(px_last)\"),lit(True)).otherwise(lit(False))) \\\n        .withColumn(\"isActive\",(sum(col(\"isTradingDay\").cast(\"long\")).over(instrumentWindow(0,20))).cast(\"boolean\") \u0026 (sum(col(\"isTradingDay\").cast(\"long\")).over(instrumentWindow(-20,0))).cast(\"boolean\")) \\\n\ndef join_composition(df):\n    composition \u003d spark.read.format(\"parquet\").load(f\"{data_source_path}/{asset_type}/{region}/{index}/composition\").select(\"date\",\"ticker\",lit(True).alias(\"inUniverse\"))\n    return df.join(composition,[\u0027date\u0027,\u0027ticker\u0027],\u0027left_outer\u0027).fillna(value\u003dFalse,subset\u003d[\"inUniverse\"])\n\ndef join_static_data():\n    def _(df):\n        static_data \u003d spark.read.format(\"parquet\").load(f\"{data_source_path}/{asset_type}/{region}/{index}/static_data\").drop(*[x for x in standardColumns if x not in [\"ticker\"]])\n        return df.join(static_data,[\u0027ticker\u0027],\u0027left_outer\u0027)\n    return _\n    \ndef join_fx(df):\n    fx \u003d spark.read.format(\"parquet\").load(f\"{data_source_path}/fx/\").withColumn(\"crncy\",expr(\"substring(ticker, 1,3)\"))\n    return df.join(fx.selectExpr(\u0027date\u0027,\u0027crncy\u0027,\u0027px_last as fx\u0027),[\u0027date\u0027,\u0027crncy\u0027],\u0027left_outer\u0027).fillna(value\u003d1.0,subset\u003d[\"fx\"])\n\n\ndef growth_rate(cols,lagRows\u003d4):\n    def _(df):\n        return df.select(*df.columns,*[when(expr(f\"{col_name}\u003e0 and lag({col_name},{lagRows}) over(partition by ticker order by date) \u003c 0\"),lit(np.NAN)).otherwise((col(col_name)-lag(col_name,lagRows).over(instrumentWindowRolling))/abs(lag(col_name,lagRows).over(instrumentWindowRolling))).alias(f\"{col_name}_growth_{lagRows}\") for col_name in cols])\n    return _\n    \ndef join_fundamental(funda_dirs,periodicities\u003d[\"Q\"],cols\u003dNone):\n    def _(df):\n        for periodicity in periodicities:\n            earnings_calendar\u003dspark.read.format(\"parquet\").load(f\"{data_source_path}/{asset_type}/{region}/{index}/earnings_calendar_{periodicity}\").selectExpr(\"date\",\"ticker\",\"announcement_dt\").where(\"!isNull(announcement_dt)\")\n            for funda_dir in funda_dirs:\n                funda \u003d spark.read.format(\"parquet\").load(f\"{data_source_path}/{asset_type}/{region}/{index}/{funda_dir}_{periodicity}\")\n                funda_cols \u003d cols if cols is not None else [x for x in funda.columns if x not in standardColumns]\n                earnings_calendar\u003dearnings_calendar.join(funda.select(\"date\",\"ticker\",*funda_cols),[\u0027date\u0027,\u0027ticker\u0027],\u0027left_outer\u0027).selectExpr(\"announcement_dt as date\",\"ticker\",f\"1 as isEarningsDay_{periodicity}\",*funda_cols)\n                earnings_calendar \u003d earnings_calendar.transform(growth_rate(funda_cols,periodicities_lag[periodicity]))\n                df\u003ddf.join(earnings_calendar,[\u0027date\u0027,\u0027ticker\u0027],\u0027left_outer\u0027)\n        return df\n    return _\n\n\ndef join_earnings_calendar(df,periodicities\u003d[\"Q\"]):\n    for periodicity in periodicities:\n        earnings_calendar\u003dspark.read.format(\"parquet\").load(f\"{data_source_path}/{asset_type}/{region}/{index}/earnings_calendar_{periodicity}\").selectExpr(\"announcement_dt as date\",\"ticker\",f\"1 as isEarningsDay_{periodicity}\").where(\"!isNull(date)\")\n        df\u003ddf.join(earnings_calendar,[\u0027date\u0027,\u0027ticker\u0027],\u0027left_outer\u0027)\n    return df\n\ndef stats_earnings_calendar(df):\n    return df.withColumn(\"daysToEarnings_Q\",first(expr(\"isEarningsDay_Q*dayCount\"),True).over(instrumentWindow(0,90)) - col(\"dayCount\")) \\\n             .withColumn(\"daysFromEarnings_Q\",last(expr(\"isEarningsDay_Q*dayCount\"),True).over(instrumentWindow(-90,0)) - col(\"dayCount\")) \\\n             .withColumn(\"daysToEarnings_S\",first(expr(\"isEarningsDay_S*dayCount\"),True).over(instrumentWindow(0,180)) - col(\"dayCount\")) \\\n             .withColumn(\"daysFromEarnings_S\",last(expr(\"isEarningsDay_S*dayCount\"),True).over(instrumentWindow(-180,0)) - col(\"dayCount\")) \\\n             .withColumn(\"daysToEarnings\",expr(\"CASE WHEN ISNULL(daysToEarnings_Q) THEN daysToEarnings_S ELSE daysToEarnings_Q END\")) \\\n             .withColumn(\"daysFromEarnings\",expr(\"CASE WHEN ISNULL(daysFromEarnings_Q) THEN daysFromEarnings_S ELSE daysFromEarnings_Q END\"))\n             \ndef join_hedges(hedgeAssetType,hedgeDir,hedgeCol,hedgeName,hedgeMap):\n    def _(df):\n        mapping_expr \u003d create_map([lit(x) for x in chain(*hedgeMap.items())])\n        indices \u003d spark.read.format(\"parquet\").load(f\"{data_source_path}/{hedgeAssetType}/{hedgeDir}/technical\").selectExpr(\"date\",f\"ticker as {hedgeName}_hdg_ticker\",f\"px_last as {hedgeName}_hdg_px_last\")\n        return df.withColumn(f\"{hedgeName}_hdg_ticker\", mapping_expr[col(hedgeCol)]) \\\n                .join(indices,[\u0027date\u0027,f\u0027{hedgeName}_hdg_ticker\u0027],\u0027left_outer\u0027)\n    return _\n    \ndef stats_hedges(hedgeName,sourceCol):\n    def _(df):\n        return df.withColumn(f\"{hedgeName}_hedged_{sourceCol}\",expr(f\"hedgedIndex(isTradingDay,{sourceCol},{hedgeName}_hdg_{sourceCol}) over(partition by ticker order by date)\"))\n    return _\n\n\ndef build_profile_pivoted(alpha,signal,numPrice,denPrice,lookBack,lookAhead):\n    def _(df):\n        return df.withColumn(\"alpha\",expr(alpha)) \\\n                .withColumn(\"signal\",expr(signal)) \\\n                .withColumn(\"numPrice\",col(numPrice)) \\\n                .withColumn(\"denPrice\",col(denPrice)) \\\n                .select( \\\n                \u0027*\u0027, \\\n                *list(expr(f\"first(numPrice,True) over(partition by ticker order by date rows between {n} following and {n}+10 following) / denPrice -1\").alias(f\u0027lead_return_{n}\u0027) for n in range(1,lookAhead)), \\\n                *list(expr(f\"last(numPrice,True) over(partition by ticker order by date rows between {n}+10 preceding and {n} preceding) / denPrice -1\").alias(f\u0027lag_return_{n}\u0027) for n in range(1,lookBack))) \\\n                \n    return _\n\ndef build_profile(alpha,signal,numPrice,denPrice,lookBack,lookAhead):\n    def _(df):\n        profile_window_size \u003d lookBack+lookAhead\n        unpivot_expr \u003d \u0027,\u0027.join([f\"\u0027{n}\u0027,lead_return_{n}\" for n in range(1,lookAhead)] + [f\"\u0027-{n}\u0027,lag_return_{n}\" for n in range(1,lookBack)])\n        unpivot_expr \u003d f\"stack({profile_window_size}-2,{unpivot_expr}) as (price_return_horizon,price_return)\"\n        return_cols \u003d [f\u0027lead_return_{n}\u0027 for n in range(1,lookAhead)] + [f\u0027lag_return_{n}\u0027 for n in range(1,lookBack)]\n\n        return df.withColumn(\"alpha\",expr(alpha)) \\\n                .withColumn(\"signal\",expr(signal)) \\\n                .withColumn(\"numPrice\",col(numPrice)) \\\n                .withColumn(\"denPrice\",col(denPrice)) \\\n                .select( \\\n                \u0027*\u0027, \\\n                *list(expr(f\"first(numPrice,True) over(partition by ticker order by date rows between {n} following and {n}+10 following) / denPrice -1\").alias(f\u0027lead_return_{n}\u0027) for n in range(1,lookAhead)), \\\n                *list(expr(f\"last(numPrice,True) over(partition by ticker order by date rows between {n}+10 preceding and {n} preceding) / denPrice -1\").alias(f\u0027lag_return_{n}\u0027) for n in range(1,lookBack))) \\\n                .select(\u0027*\u0027,expr(unpivot_expr)) \\\n                .drop(*[cols for cols in return_cols])\n    return _\n\ndef forward_fill(cols,observation\u003d63):\n    def _(df):\n        return df.select(*[col for col in df.columns if col not in cols],*[last(col_name,True).over(instrumentWindow(-observation,0)).alias(col_name) for col_name in cols]) \\\n                 .select(*[col for col in df.columns if col not in cols],*[when(isnan(col_name),lit(None)).otherwise(col(col_name)).alias(col_name) for col_name in cols])\n    return _\n                \ndef cs_z_score(group,cols):\n    def _(df):\n        return df.select(*df.columns,*[expr(f\"({col_name}-avg({col_name}) over(partition by date,isActive,inUniverse,{group})) / (stddev({col_name}) over(partition by date,isActive,inUniverse,{group}))\").alias(f\"{col_name}_cs_zscore_{group}\") for col_name in cols])\n    return _\n    \ndef cs_iqr(group,cols):\n    def _(df):\n        return df.select(*df.columns,*[expr(f\"({col_name}-percentile_approx({col_name},0.5) over(partition by date,isActive,inUniverse,{group})) / (percentile_approx({col_name},0.75) over(partition by date,isActive,inUniverse,{group}) - percentile_approx({col_name},0.25) over(partition by date,isActive,inUniverse,{group}))\").alias(f\"{col_name}_cs_iqr_{group}\") for col_name in cols])\n    return _\n    \ndef volume_stats(advLookbacks\u003d[20],lag\u003d1,volumeColumn\u003d\"volume\"):\n    def _(df):\n        return df.select(*df.columns,*[avg(volumeColumn).over(instrumentWindow(-lookback,-lag)).alias(f\"adv_{lookback}d\") for lookback in advLookbacks])\n    return _\n    \ndef volatility_stats(volLookbacks\u003d[20],lag\u003d1,return_column\u003d\"return_1d\",annualize\u003dTrue):\n    def _(df):\n        return df.select(*df.columns,*[((expr(\"sqrt(252)\") if annualize \u003d\u003d True else lit(1))*stddev(expr(f\"log(1+{return_column})\")).over(instrumentWindow(-lookback,-lag))).alias(f\"vol_{lookback}d\") for lookback in volLookbacks])\n    return _\n\ndef lag_return(returnLags\u003d[1],lookback\u003d10,pxColumn\u003d\"px_last\"):\n    def _(df):\n        return df.select(*df.columns,*[(last(pxColumn,True).over(instrumentWindow(-lookback,0)) / last(pxColumn,True).over(instrumentWindow(-lookback,-lag)) - 1).alias(f\"return_{lag}d\") for lag in returnLags])\n    return _",
      "user": "anonymous",
      "dateUpdated": "2024-04-15 13:44:04.161",
      "progress": 0,
