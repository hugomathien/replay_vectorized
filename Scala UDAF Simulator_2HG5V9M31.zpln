{
  "paragraphs": [
    {
      "text": "%spark\nimport org.apache.spark.sql.expressions.MutableAggregationBuffer\nimport org.apache.spark.sql.expressions.UserDefinedAggregateFunction\nimport org.apache.spark.sql.Row\nimport org.apache.spark.sql.types._\nimport scala.collection.mutable._\n\n/**\n* Class TradingSimulator extends UserDefinedAggregateFunction\n* The backtesting function is written in the update method: it will be called for every row sequentially over a window partitioned by symbol.\n* The size of the trade is directly provided in config (either as a number or a formula) or implied from a portfolio budget multiplied by a weight.\n* The daily pnl is computed in the stock\u0027s local currency from the variations of the mark to market + cash position: day_pnl(t) \u003d (cash(t)+mtm(t)) - cash(t-1) - mtm(t-1)\n* Mark to market is the net delta of the position (positionNetQuantity * valuationPrice)\n* Cash is our cash holding, which decreases/increases when we buy/sell a stock, in line with the amount of the transaction.\n* The day_pnl should be converted to the backtester currency when results are aggregated to date level. This is essentialy simulating a daily fx hedging of the pnl (without carry cost assumptions for simplicity)\n* If a holding period is provided every new trade will be added to a queue and dequeued after the holding period to create an unwind trade. \n**/\nclass TradingSimulator extends UserDefinedAggregateFunction {\n    \n  var tradeQueue \u003d new HashMap[String,Queue[Tuple2[Long,Long]]]()\n    \n  // This is the input fields for the aggregate function.\n  override def inputSchema \u003d new StructType()\n                                .add(\"isTradingDay\", BooleanType)\n                                .add(\"price\", DoubleType,true)\n                                .add(\"direction\", IntegerType,true)\n                                .add(\"weight\", DoubleType,true)\n                                .add(\"budget\", DoubleType,true)\n                                .add(\"eventBudget\", DoubleType,true)\n                                .add(\"holdingPeriod\", IntegerType,true)\n                                .add(\"maxTradeSize\", DoubleType,true)\n                                .add(\"maxPositionSize\", DoubleType,true)\n                                .add(\"maxTradeAdv\", DoubleType,true)\n                                .add(\"maxPositionAdv\", DoubleType,true)\n                                .add(\"fx\", DoubleType,true)\n                                .add(\"volume\", LongType,true)\n                                .add(\"adv\", LongType,true)\n                                .add(\"observationCount\", LongType,true)\n                                .add(\"rebalancingFrequency\", IntegerType,true)\n                                .add(\"ticker\", StringType,true)\n                                \n  // This is the internal fields we keep for computing the aggregate.\n  override def bufferSchema: StructType \u003d StructType(\n    StructField(\"cash\", DoubleType) ::\n    StructField(\"mtm\", DoubleType) ::\n    StructField(\"dayPnl\", DoubleType) ::\n    StructField(\"positionNetQuantity\", LongType) ::\n    StructField(\"tradeNetQuantity\", LongType) ::\n    StructField(\"unwindNetQuantity\", LongType) ::\n    StructField(\"valuationPrice\", DoubleType) :: \n    StructField(\"toRebalance\", BooleanType) :: Nil\n  )\n\n  // This is the output type of the aggregatation function.\n  override def dataType: StructType \u003d StructType(\n    StructField(\"cash\", DoubleType) ::\n    StructField(\"mtm\", DoubleType) ::\n    StructField(\"dayPnl\", DoubleType) ::\n    StructField(\"positionNetQuantity\", LongType) ::\n    StructField(\"tradeNetQuantity\", LongType) ::\n    StructField(\"unwindNetQuantity\", LongType) ::\n    StructField(\"valuationPrice\", DoubleType) ::\n    StructField(\"toRebalance\", BooleanType) :: Nil\n  )\n\n  override def deterministic: Boolean \u003d true\n\n  // This is the initial value for our buffer schema.\n  override def initialize(buffer: MutableAggregationBuffer): Unit \u003d {\n    buffer(0) \u003d 0D\n    buffer(1) \u003d 0D\n    buffer(2) \u003d 0D\n    buffer(3) \u003d 0L\n    buffer(4) \u003d 0L\n    buffer(5) \u003d 0L\n    buffer(6) \u003d 0D\n    buffer(7) \u003d true\n  }\n\n  override def update(buffer: MutableAggregationBuffer, input: Row): Unit \u003d {\n    // Extract row values from the input\n    val isTradingDay \u003d input.getAs[Boolean](0)\n    val price \u003d input.getAs[Double](1)\n    val direction \u003d input.getAs[Integer](2)\n    val weight \u003d input.getAs[Double](3)\n    val budget \u003d input.getAs[Double](4)\n    val eventBudget \u003d input.getAs[Double](5)\n    val holdingPeriod \u003d input.getAs[Integer](6)\n    val maxTradeSize \u003d input.getAs[Double](7)\n    val maxPositionSize \u003d input.getAs[Double](8)\n    val maxTradeAdv \u003d input.getAs[Double](9)\n    val maxPositionAdv \u003d input.getAs[Double](10)\n    val fx \u003d input.getAs[Double](11)\n    val volume \u003d input.getAs[Long](12)\n    val adv \u003d input.getAs[Long](13)\n    val priceInSimCurrency \u003d price * fx // Fx all prices in the currency used by the simulator\n    val observationCount \u003d input.getAs[Long](14)\n    val rebalancingFrequency \u003d input.getAs[Integer](15)\n    val ticker \u003d input.getAs[String](16)\n\n    // Whether to rebalance the stock position or not.\n    var toRebalance \u003d if (buffer.getBoolean(7) \u003d\u003d false \u0026 (observationCount % rebalancingFrequency \u003e 0)) false else true\n    var stockQueue \u003d tradeQueue.getOrElseUpdate(ticker,Queue[Tuple2[Long,Long]]())\n    \n    if(isTradingDay) {\n        var positionNetQuantity \u003d buffer.getLong(3)\n        var positionNetDelta \u003d positionNetQuantity * priceInSimCurrency\n        \n        // If we have provided holding periods we dequeue the trades eligible for unwind\n        var unwindNetQuantity \u003d 0L\n        if(holdingPeriod \u003e 0) {\n            unwindNetQuantity \u003d -1 * stockQueue.dequeueAll(observationCount - _._1 \u003e\u003d holdingPeriod).map(x \u003d\u003e x._2 ).sum\n            positionNetDelta \u003d positionNetDelta + unwindNetQuantity * priceInSimCurrency\n        }\n        \n        // On rebalancing we create a trade after applying a set of constraints \n        var tradeNetQuantity \u003d 0L\n        if(toRebalance) { \n            var targetPositionNetDelta \u003d if(eventBudget \u003e0) positionNetDelta + eventBudget * direction else weight * budget * direction\n            targetPositionNetDelta \u003d Math.min(maxPositionAdv*adv*priceInSimCurrency,Math.min(Math.abs(targetPositionNetDelta),maxPositionSize)) * Math.signum(targetPositionNetDelta)\n            var targetTradeDelta \u003d (targetPositionNetDelta - positionNetDelta) \n            targetTradeDelta \u003d Math.min(maxTradeAdv*volume*priceInSimCurrency,Math.min(Math.abs(targetTradeDelta),maxTradeSize)) * Math.signum(targetTradeDelta)\n            tradeNetQuantity \u003d Math.round(targetTradeDelta / priceInSimCurrency)\n        }\n        \n        // Calculate what will be our position after the unwind and risk trade\n        positionNetQuantity \u003d positionNetQuantity + tradeNetQuantity + unwindNetQuantity\n        \n        // Calculate today\u0027s pnl\n        val cash \u003d buffer.getDouble(0) - tradeNetQuantity * price - unwindNetQuantity * price // cash position in local ccy\n        val mtm \u003d positionNetQuantity * price  // mark to market in local ccy\n        val dayPnl \u003d cash+mtm - buffer.getDouble(0) - buffer.getDouble(1) // in local ccy\n    \n        // Update the buffer\n        buffer(0) \u003d cash\n        buffer(1) \u003d mtm\n        buffer(2) \u003d dayPnl\n        buffer(3) \u003d positionNetQuantity\n        buffer(4) \u003d tradeNetQuantity\n        buffer(5) \u003d -1*unwindNetQuantity\n        buffer(6) \u003d price\n        buffer(7) \u003d false\n        \n        // Enqueue the risk trade if we have a holding period\n        if(holdingPeriod \u003e0 \u0026\u0026 tradeNetQuantity !\u003d 0 \u0026\u0026 direction !\u003d 0)\n            stockQueue.enqueue((observationCount, tradeNetQuantity))\n\n    }\n    else {  \n        if(toRebalance) // we were supposed to rebalance but the stock is not trading, we will rebalance it on the next trading day\n            buffer(7) \u003d true\n            \n        // Set the day pnl, traded and unwound quantities to zero since the stock is not trading\n        buffer(2) \u003d 0D\n        buffer(4) \u003d 0L\n        buffer(5) \u003d 0L\n    }\n\n    \n  }\n\n  // This is how to merge two objects with the bufferSchema type.\n  override def merge(buffer1: MutableAggregationBuffer, buffer2: Row): Unit \u003d {\n    \n  }\n\n  // The output is our buffer, we can extract the values using StructType, for example \"backtest.day_pnl\"\n  override def evaluate(buffer: Row)\u003d buffer\n}\n\n// Register to use with Spark SQL and access via Pyspark\nspark.udf.register(\"tradingSim\", new TradingSimulator)\n",
      "user": "anonymous",
      "dateUpdated": "2023-08-30 16:05:11.941",
